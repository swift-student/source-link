# Modern source-link scheme; successful path. Cancellation stops; errors show an alert.
direction: down
classes: {
  step: {style: {fill: "#EFF6FF"; stroke: "#4F6D92"; border-radius: 9}; width: 260}
  choice: {shape: diamond; style: {fill: "#FFF4DC"; stroke: "#AC8230"}}
  finish: {style: {fill: "#E7F5EE"; stroke: "#418465"; border-radius: 9}; width: 260}
}
receive: "Receive URL" {
  class: step
  link: "source-link://source-link/app/Sources/SourceLinkApp/App.swift?line=53"
}
parse: "Parse repository, path, position" {
  class: step
  link: "source-link://source-link/Sources/SourceLinkCore/SourceLink.swift?line=9"
}
checkout: "Checkout selected?" {
  class: choice
  link: "source-link://source-link/Sources/SourceLinkCore/SourceSettings.swift?line=10"
}
setup: "Choose checkout and editor" {
  class: step
  link: "source-link://source-link/app/Sources/SourceLinkApp/App.swift?line=69"
}
resolve: "Validate file inside checkout" {
  class: step
  link: "source-link://source-link/Sources/SourceLinkCore/SourceLink.swift?line=43"
}
command: "Choose editor and arguments" {
  class: step
  link: "source-link://source-link/Sources/SourceLinkCore/SourceSettings.swift?line=26"
}
run: "Launch editor process" {
  class: finish
  link: "source-link://source-link/Sources/SourceLinkCore/EditorCommand.swift?line=25"
}
receive -> parse -> checkout
checkout -> resolve: yes
checkout -> setup: no
setup -> resolve: saved
resolve -> command -> run

title: "Source Link / URL to editor" {
 shape: text
 near: top-center
 style.font-size: 24
}
