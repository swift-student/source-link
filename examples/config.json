{
  "checkouts": [
    {
      "default": true,
      "name": "source-link",
      "path": "~/workspace/source-link"
    },
    {
      "name": "source-link",
      "path": "~/workspace/source-link-feature"
    }
  ],
  "default_editor": "cursor",
  "executables": {
    "cursor": "/Applications/Cursor.app/Contents/Resources/app/bin/cursor"
  },
  "rules": [
    {
      "editor": "xcode",
      "extension": "swift"
    },
    {
      "editor": "cursor",
      "extension": "md"
    }
  ],
  "version": 1,
  "editors": {
    "idea": {
      "name": "IntelliJ IDEA",
      "executable": "/Applications/IntelliJ IDEA.app/Contents/MacOS/idea",
      "arguments": [
        "{file}"
      ],
      "line_arguments": [
        "--line",
        "{line}",
        "{file}"
      ],
      "column_arguments": [
        "--line",
        "{line}",
        "--column",
        "{column}",
        "{file}"
      ]
    }
  }
}
